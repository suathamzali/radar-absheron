{
  "name": "radar-absheron-intro",
  "private": true,
  "description": "6-second logo intro for Radar Absheron (Remotion).",
  "scripts": { "render": "remotion render src/index.ts Intro out/intro.mp4", "still": "remotion still src/index.ts Intro out/intro.png --frame=150",
    "promo": "remotion render src/index.ts Promo out/promo --sequence --image-format=jpeg && ffmpeg -framerate 30 -i out/promo/element-%04d.jpeg -c:v libx264 -pix_fmt yuv420p -crf 20 promo.mp4" },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  }
}
